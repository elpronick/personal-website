---
// Contact.astro - Sección de Comunicación Directa según maqueta Stitch
---

<section class="contact section" id="contacto">
  <div class="contact__container container">
    <div class="contact__card">
      <!-- Glow ambiental de fondo -->
      <div class="contact__glow" aria-hidden="true"></div>

      <div class="contact__grid">
        <!-- Columna Izquierda: Mensaje y Acciones (7 cols) -->
        <div class="contact__info">
          <div class="contact__label-group">
            <span class="contact__label text-mono">04 / Comunicación Directa</span>
            <div class="contact__label-line"></div>
          </div>

          <h2 class="contact__title">
            ¿Tienes un proyecto exigente o una posición técnica abierta?
          </h2>

          <p class="contact__desc">
            Estoy disponible para roles como Full Stack Engineer, diseño de arquitecturas cloud, o consultoría de rendimiento. Puedes contactarme directamente por correo electrónico o a través de mis perfiles profesionales.
          </p>

          <!-- Botones de Acción -->
          <div class="contact__actions">
            <!-- Botón de Copiado de Email modularizado sin onclick inline -->
            <button class="contact__btn-copy" id="copy-email-btn" type="button" aria-label="Copiar correo electrónico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact__btn-icon" id="copy-icon">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-text">Copiar Email (elpronick.dev@gmail.com)</span>
            </button>

            <a href="mailto:elpronick.dev@gmail.com" class="contact__btn-mail">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact__btn-icon">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>Abrir Gestor de Correo</span>
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Terminal (5 cols) -->
        <div class="contact__terminal">
          <!-- Terminal Faux Header -->
          <div class="contact__terminal-header">
            <div class="contact__terminal-dots">
              <span class="contact__terminal-dot"></span>
              <span class="contact__terminal-dot"></span>
              <span class="contact__terminal-dot"></span>
            </div>
            <span class="contact__terminal-file text-mono">connection_status.sh</span>
          </div>

          <!-- Monospace Contact Details -->
          <div class="contact__terminal-body text-mono">
            <div class="contact__terminal-row">
              <span class="contact__terminal-prompt">&gt;</span>
              <div class="contact__terminal-entry">
                <span class="contact__terminal-key">location:</span>
                <span class="contact__terminal-val">Valencia, España / Remoto</span>
              </div>
            </div>

            <div class="contact__terminal-row">
              <span class="contact__terminal-prompt">&gt;</span>
              <div class="contact__terminal-entry">
                <span class="contact__terminal-key">email:</span>
                <a href="mailto:elpronick.dev@gmail.com" class="contact__terminal-link">elpronick.dev@gmail.com</a>
              </div>
            </div>

            <div class="contact__terminal-row">
              <span class="contact__terminal-prompt">&gt;</span>
              <div class="contact__terminal-entry">
                <span class="contact__terminal-key">github:</span>
                <a href="https://github.com/elpronick" target="_blank" rel="noopener noreferrer" class="contact__terminal-val-link">@elpronick</a>
              </div>
            </div>

            <div class="contact__terminal-row">
              <span class="contact__terminal-prompt">&gt;</span>
              <div class="contact__terminal-entry">
                <span class="contact__terminal-key">linkedin:</span>
                <a href="https://linkedin.com/in/elpronick" target="_blank" rel="noopener noreferrer" class="contact__terminal-val-link">/in/elpronick</a>
              </div>
            </div>

            <div class="contact__terminal-row">
              <span class="contact__terminal-prompt">&gt;</span>
              <div class="contact__terminal-entry">
                <span class="contact__terminal-key">pgp_fingerprint:</span>
                <span class="contact__terminal-muted">4A89 9C21 B012 D8E1 ...</span>
              </div>
            </div>

            <div class="contact__terminal-footer">
              <span class="contact__terminal-status">● Response time &lt; 24h</span>
              <span class="contact__terminal-tz">UTC+1 (CET)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Script nativo de copiado sin onclick inline con validación segura de clipboard
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const copyIcon = document.getElementById('copy-icon');
  const email = 'elpronick.dev@gmail.com';

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(email);
        } else {
          // Fallback para entornos donde Clipboard API no esté disponible
          const textArea = document.createElement('textarea');
          textArea.value = email;
          textArea.style.position = 'fixed';
          textArea.style.left = '-999999px';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          document.execCommand('copy');
          textArea.remove();
        }

        if (copyText && copyIcon) {
          const originalText = copyText.textContent;
          copyText.textContent = '¡Email copiado al portapapeles!';
          copyIcon.innerHTML = `<polyline points="20 6 9 17 4 12"></polyline>`;
          setTimeout(() => {
            copyText.textContent = originalText;
            copyIcon.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>`;
          }, 3000);
        }
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>

<style lang="scss">
  .contact {
    &__card {
      position: relative;
      @include card-surface;
      padding: 3rem 2.5rem;
      overflow: hidden;

      @include respond-to(tablet) {
        padding: 2rem 1.5rem;
      }
    }

    &__glow {
      position: absolute;
      right: -60px;
      bottom: -60px;
      width: 320px;
      height: 320px;
      border-radius: $radius-full;
      background: rgba(245, 158, 11, 0.15);
      filter: blur(80px);
      pointer-events: none;
    }

    &__grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: center;

      @include respond-to(desktop) {
        grid-template-columns: 1.25fr 0.95fr;
      }
    }

    &__info {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    &__label-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    &__label {
      font-size: 0.75rem;
      font-weight: 600;
      color: $color-primary;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    &__label-line {
      height: 1px;
      width: 3.5rem;
      background: $color-surface-container-highest;
    }

    &__title {
      font-size: clamp(1.75rem, 2.8vw + 0.5rem, 2.35rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: $color-text-primary;
      line-height: 1.2;
    }

    &__desc {
      font-size: 1rem;
      line-height: 1.75;
      color: $color-text-secondary;
      max-width: 580px;
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      padding-top: 0.5rem;
    }

    &__btn-copy {
      @include button-primary;
      padding: 0.85rem 1.5rem;
      font-size: 0.875rem;
      border-radius: $radius-md;
    }

    &__btn-mail {
      @include button-secondary;
      padding: 0.85rem 1.5rem;
      font-size: 0.875rem;
      border-radius: $radius-md;
    }

    &__btn-icon {
      width: 18px;
      height: 18px;
    }

    // Columna Terminal
    &__terminal {
      display: flex;
      flex-direction: column;
      border-radius: $radius-xl;
      background: $color-surface-elevated;
      border: 1px solid $color-border-subtle;
      box-shadow: $shadow-card;
      padding: 1.5rem;
      gap: 0.75rem;
    }

    &__terminal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(42, 50, 67, 0.4);
    }

    &__terminal-dots {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    &__terminal-dot {
      width: 10px;
      height: 10px;
      border-radius: $radius-full;
      background: $color-surface-container-highest;
    }

    &__terminal-file {
      font-size: 0.75rem;
      color: $color-text-muted;
    }

    &__terminal-body {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.8125rem;
      padding-top: 0.5rem;
    }

    &__terminal-row {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    &__terminal-prompt {
      color: $color-primary;
      font-weight: 700;
    }

    &__terminal-entry {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    &__terminal-key {
      color: $color-text-muted;
    }

    &__terminal-val {
      color: $color-text-primary;
    }

    &__terminal-link {
      color: $color-primary;
      text-decoration: underline;

      &:hover {
        color: $color-primary-light;
      }
    }

    &__terminal-val-link {
      color: $color-text-primary;
      transition: color $transition-fast;

      &:hover {
        color: $color-primary;
      }
    }

    &__terminal-muted {
      color: $color-text-muted;
    }

    &__terminal-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: $radius-md;
      background: $color-surface-container-high;
      font-size: 0.75rem;
    }

    &__terminal-status {
      color: $color-status-available;
      font-weight: 500;
    }

    &__terminal-tz {
      color: $color-text-muted;
    }
  }
</style>
