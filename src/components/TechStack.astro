---
// TechStack.astro - Ecosistema Técnico (Bento Grid 4 Categorías) según maqueta Stitch
---

<section class="tech-stack section" id="tech-stack">
  <div class="tech-stack__container container">
    <!-- Header de Sección -->
    <div class="tech-stack__header">
      <div class="tech-stack__label-group">
        <span class="tech-stack__label text-mono">02 / Ecosistema Técnico</span>
        <div class="tech-stack__label-line"></div>
      </div>
      <h2 class="tech-stack__title">Herramientas &amp; Tecnologías de Producción</h2>
      <p class="tech-stack__subtitle">
        Stack depurado para entregar velocidad, tipado riguroso y arquitectura mantenible en cada capa.
      </p>
    </div>

    <!-- 4 Categories Bento Grid -->
    <div class="tech-stack__grid">
      <!-- Categoria 1: Frontend -->
      <div class="tech-stack__card">
        <div class="tech-stack__card-top">
          <div class="tech-stack__icon-box tech-stack__icon-box--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tech-stack__icon">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <span class="tech-stack__card-index text-mono">01_FRONTEND</span>
        </div>
        <h3 class="tech-stack__card-title">Frontend</h3>
        <p class="tech-stack__card-desc">Interfaces reactivas, semántica accesible y bundle size optimizado.</p>
        <div class="tech-stack__chips">
          <span class="tech-stack__chip">React</span>
          <span class="tech-stack__chip tech-stack__chip--highlight">TypeScript</span>
          <span class="tech-stack__chip">Astro</span>
          <span class="tech-stack__chip">HTML5 Semántico</span>
          <span class="tech-stack__chip">SASS / SCSS</span>
          <span class="tech-stack__chip">Tailwind CSS</span>
        </div>
      </div>

      <!-- Categoria 2: Backend -->
      <div class="tech-stack__card">
        <div class="tech-stack__card-top">
          <div class="tech-stack__icon-box tech-stack__icon-box--secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tech-stack__icon">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <span class="tech-stack__card-index text-mono">02_BACKEND</span>
        </div>
        <h3 class="tech-stack__card-title">Backend</h3>
        <p class="tech-stack__card-desc">Lógica de negocio asíncrona, control transaccional y APIs modulares.</p>
        <div class="tech-stack__chips">
          <span class="tech-stack__chip tech-stack__chip--secondary">Node.js</span>
          <span class="tech-stack__chip">Express</span>
          <span class="tech-stack__chip tech-stack__chip--highlight">Python</span>
          <span class="tech-stack__chip">RESTful APIs</span>
          <span class="tech-stack__chip">Clean Architecture</span>
        </div>
      </div>

      <!-- Categoria 3: Databases -->
      <div class="tech-stack__card">
        <div class="tech-stack__card-top">
          <div class="tech-stack__icon-box tech-stack__icon-box--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tech-stack__icon">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <span class="tech-stack__card-index text-mono">03_DATABASES</span>
        </div>
        <h3 class="tech-stack__card-title">Bases de Datos</h3>
        <p class="tech-stack__card-desc">Diseño relacional consistente, índices optimizados y consultas eficientes.</p>
        <div class="tech-stack__chips">
          <span class="tech-stack__chip tech-stack__chip--highlight">PostgreSQL</span>
          <span class="tech-stack__chip">Modelado Relacional</span>
          <span class="tech-stack__chip">SQL Optimizado</span>
          <span class="tech-stack__chip">Redis Cache</span>
          <span class="tech-stack__chip">ORMs / Query Builders</span>
        </div>
      </div>

      <!-- Categoria 4: Tools & DevOps -->
      <div class="tech-stack__card">
        <div class="tech-stack__card-top">
          <div class="tech-stack__icon-box tech-stack__icon-box--secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tech-stack__icon">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="tech-stack__card-index text-mono">04_DEVOPS_ENV</span>
        </div>
        <h3 class="tech-stack__card-title">Herramientas &amp; Entorno</h3>
        <p class="tech-stack__card-desc">Automatización de despliegue, entornos reproducibles y control de versiones.</p>
        <div class="tech-stack__chips">
          <span class="tech-stack__chip">Git &amp; GitHub</span>
          <span class="tech-stack__chip tech-stack__chip--secondary">GitHub Actions</span>
          <span class="tech-stack__chip">Docker</span>
          <span class="tech-stack__chip">Vite</span>
          <span class="tech-stack__chip">Linux / Bash</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .tech-stack {
    &__header {
      margin-bottom: 2.5rem;
    }

    &__label-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    &__label {
      font-size: 0.75rem;
      font-weight: 600;
      color: $color-primary;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    &__label-line {
      height: 1px;
      width: 4rem;
      background: $color-surface-container-highest;
    }

    &__title {
      font-size: clamp(1.85rem, 3.2vw + 0.5rem, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: $color-text-primary;
      margin-bottom: 0.75rem;
    }

    &__subtitle {
      font-size: 1rem;
      line-height: 1.65;
      color: $color-text-secondary;
      max-width: 600px;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;

      @include respond-to(tablet) {
        grid-template-columns: repeat(2, 1fr);
      }

      @include respond-to(desktop) {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    &__card {
      @include card-surface;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        background: $color-surface-hover;
        transform: translateY(-4px);
      }

      &-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      &-index {
        font-size: 0.75rem;
        color: $color-text-muted;
      }

      &-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: $color-text-primary;
      }

      &-desc {
        font-size: 0.875rem;
        line-height: 1.55;
        color: $color-text-secondary;
      }
    }

    &__icon-box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: $radius-md;
      background: $color-surface-elevated;
      border: 1px solid $color-border-subtle;

      &--primary {
        color: $color-primary;
      }
      &--secondary {
        color: $color-secondary;
      }
    }

    &__icon {
      width: 20px;
      height: 20px;
    }

    &__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: auto;
      padding-top: 0.5rem;
    }

    &__chip {
      padding: 0.25rem 0.65rem;
      border-radius: $radius-full;
      background: $color-surface-elevated;
      font-family: $font-mono;
      font-size: 0.75rem;
      color: $color-text-secondary;
      border: 1px solid rgba(42, 50, 67, 0.5);
      transition: all $transition-fast;

      &--highlight {
        color: $color-primary;
        border-color: rgba(245, 158, 11, 0.3);
      }

      &--secondary {
        color: $color-secondary;
        border-color: rgba(236, 106, 6, 0.3);
      }

      &:hover {
        border-color: $color-primary;
        color: $color-text-primary;
      }
    }
  }
</style>
