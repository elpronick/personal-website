---
// About.astro - Perfil de Ingeniería y Bento Grid según maqueta Stitch
---

<section class="about section" id="sobre-mi">
  <div class="about__container container">
    <!-- Header de Sección -->
    <div class="about__header">
      <div class="about__label-group">
        <span class="about__label text-mono">01 / Perfil de Ingeniería</span>
        <div class="about__label-line"></div>
      </div>
      <h2 class="about__title">Arquitectura Limpia &amp; Resolución Analítica</h2>
    </div>

    <!-- Bento Grid Content -->
    <div class="about__grid">
      <!-- Columna Izquierda: Narrativa y Principios (7 cols) -->
      <div class="about__narrative-box">
        <h3 class="about__narrative-title">
          Desarrollo pragmático orientado a impacto real
        </h3>
        <p class="about__narrative-desc">
          Como ingeniero de software me enfoco en diseñar sistemas con alta cohesión y bajo acoplamiento. Mi metodología de trabajo prioriza la estabilidad técnica desde el primer commit: tipado estricto, abstracciones bien delimitadas y documentación ejecutable.
        </p>
        <p class="about__narrative-desc">
          Utilizo activamente <strong class="about__strong">Astro</strong> para experiencias hiper-rápidas sin sobrecarga de runtime cliente, <strong class="about__strong">React</strong> para paneles reactivos de alta complejidad, y <strong class="about__strong">Node.js / Python</strong> para servicios robustos de procesamiento y persistencia transaccional con <strong class="about__strong">PostgreSQL</strong>.
        </p>

        <!-- Core Values Bento -->
        <div class="about__values-grid">
          <div class="about__value-card">
            <div class="about__value-icon-box about__value-icon-box--primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="about__value-icon">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
              </svg>
            </div>
            <div class="about__value-info">
              <h4 class="about__value-title">Diseño Modular</h4>
              <p class="about__value-desc">Separación clara de responsabilidades y capas de datos desacopladas.</p>
            </div>
          </div>

          <div class="about__value-card">
            <div class="about__value-icon-box about__value-icon-box--secondary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="about__value-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="about__value-info">
              <h4 class="about__value-title">Eficiencia Extrema</h4>
              <p class="about__value-desc">Zero JS superfluo, tiempos de respuesta sub-100ms y optimización SQL.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tarjetas de Métricas de Ingeniería (5 cols) -->
      <div class="about__metrics-column">
        <!-- Metric 1 -->
        <div class="about__metric-card">
          <div class="about__metric-data">
            <span class="about__metric-value about__metric-value--primary">+15</span>
            <span class="about__metric-label">Proyectos desarrollados &amp; desplegados</span>
          </div>
          <div class="about__metric-icon-box about__metric-icon-box--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="about__metric-icon">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
          </div>
        </div>

        <!-- Metric 2 -->
        <div class="about__metric-card">
          <div class="about__metric-data">
            <span class="about__metric-value about__metric-value--secondary">100%</span>
            <span class="about__metric-label">Código tipado con TypeScript &amp; Python Typings</span>
          </div>
          <div class="about__metric-icon-box about__metric-icon-box--secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="about__metric-icon">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>

        <!-- Metric 3 -->
        <div class="about__metric-card">
          <div class="about__metric-data">
            <span class="about__metric-value about__metric-value--green">REST / WS</span>
            <span class="about__metric-label">APIs escalables &amp; protocolos en tiempo real</span>
          </div>
          <div class="about__metric-icon-box about__metric-icon-box--green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="about__metric-icon">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .about {
    &__header {
      margin-bottom: 2.5rem;
    }

    &__label-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    &__label {
      font-size: 0.75rem;
      font-weight: 600;
      color: $color-primary;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    &__label-line {
      height: 1px;
      width: 4rem;
      background: $color-surface-container-highest;
    }

    &__title {
      font-size: clamp(1.85rem, 3.2vw + 0.5rem, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: $color-text-primary;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;

      @include respond-to(desktop) {
        grid-template-columns: 1.35fr 0.95fr;
      }
    }

    &__narrative-box {
      @include card-surface;
      padding: 2.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;

      @include respond-to(tablet) {
        padding: 1.5rem;
      }
    }

    &__narrative-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: $color-text-primary;
    }

    &__narrative-desc {
      font-size: 1rem;
      line-height: 1.75;
      color: $color-text-secondary;
    }

    &__strong {
      color: $color-text-primary;
      font-weight: 600;
    }

    &__values-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 0.75rem;

      @include respond-to(tablet) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    &__value-card {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.85rem;
      border-radius: $radius-lg;
      background: $color-surface-elevated;
      border: 1px solid rgba(42, 50, 67, 0.4);
    }

    &__value-icon-box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: $radius-md;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.04);

      &--primary {
        color: $color-primary;
      }
      &--secondary {
        color: $color-secondary;
      }
    }

    &__value-icon {
      width: 18px;
      height: 18px;
    }

    &__value-info {
      display: flex;
      flex-direction: column;
    }

    &__value-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: $color-text-primary;
    }

    &__value-desc {
      font-size: 0.785rem;
      line-height: 1.5;
      color: $color-text-muted;
    }

    // Columna de Métricas
    &__metrics-column {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    &__metric-card {
      @include card-surface;
      padding: 1.5rem 1.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;

      &:hover {
        background: $color-surface-hover;
      }
    }

    &__metric-data {
      display: flex;
      flex-direction: column;
    }

    &__metric-value {
      font-size: 2.25rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.03em;
      margin-bottom: 0.35rem;

      &--primary {
        color: $color-primary;
      }
      &--secondary {
        color: $color-secondary;
      }
      &--green {
        color: $color-status-available;
      }
    }

    &__metric-label {
      font-size: 0.8125rem;
      color: $color-text-secondary;
    }

    &__metric-icon-box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: $radius-lg;
      background: $color-surface-elevated;
      border: 1px solid $color-border-subtle;

      &--primary {
        color: $color-primary;
      }
      &--secondary {
        color: $color-secondary;
      }
      &--green {
        color: $color-status-available;
      }
    }

    &__metric-icon {
      width: 24px;
      height: 24px;
    }
  }
</style>
